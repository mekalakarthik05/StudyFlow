{
  "name": "studyflow",
  "version": "1.0.0",
  "description": "StudyFlow - AI-Powered Study Assistant",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "concurrently \"npm run start --workspace=server\" \"npm run dev --workspace=client\"",
    "server": "npm run start --workspace=server",
    "client": "npm run dev --workspace=client",
    "test": "node client/src/lib/validateResult.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
